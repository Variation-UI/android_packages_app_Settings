<com.android.settingslib.widget.DrawableStateLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/about_phone_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:clipToPadding="false"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/about_phone_card"
        style="@style/AboutPhoneInfoCard">

        <LinearLayout
            android:id="@+id/about_phone_card_text_container"
            style="@style/AboutPhoneInfoCardTextContainer">
            <TextView
                android:id="@+id/about_phone_card_title"
                style="@style/AboutPhoneInfoCardTitle"/>

            <TextView
                android:id="@+id/about_phone_card_summary"
                style="@style/AboutPhoneInfoCardSummary"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/about_phone_card_icon_frame"
            style="@style/AboutPhoneInfoCardIconFrame">
            <ImageView
                android:id="@+id/about_phone_card_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"/>
        </FrameLayout>

        <ImageView
            android:id="@+id/about_phone_card_chevron"
            style="@style/AboutPhoneInfoCardChevron"/>
    </LinearLayout>
</com.android.settingslib.widget.DrawableStateLinearLayout>
